<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DarkMountStudio</AssemblyName>
    <RootNamespace>DarkMountStudio</RootNamespace>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <!-- The settings page is embedded straight from the project folder above; rebuilding picks up changes. -->
  <ItemGroup>
    <EmbeddedResource Include="..\index.html" LogicalName="site/index.html" Link="site\index.html" />
    <EmbeddedResource Include="..\styles.css" LogicalName="site/styles.css" Link="site\styles.css" />
    <EmbeddedResource Include="..\js\*.js" LogicalName="site/js/%(Filename)%(Extension)" Link="site\js\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HidSharp" Version="2.1.0" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

</Project>
